# Server-only settings for the optional assistant. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
# A text model available to your OpenAI project that supports the Responses API.
OPENAI_MODEL=

# Leave empty to use the /api/chat function on the same Vercel deployment.
# Only set this if you already host a compatible API with CORS enabled elsewhere.
VITE_API_BASE_URL=
